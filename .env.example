# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# --- Client (exposed to the browser at build time via Vite) ---
# Free key from https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here

# --- Server-only (never exposed to the browser) ---
# Powers the "AI Movie Finder" feature.
GEMINI_API_KEY=your_gemini_key_here

# Port the Express server listens on (also used by the Vite dev proxy).
PORT=5000
